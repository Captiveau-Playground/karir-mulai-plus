{
  "name": "karir-mulai-plus",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^22.20.1",
      "@cloudflare/workers-types": "^5.20260728.1",
      "hono": "^4.12.32",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.6.25",
      "alchemy": "^0.93.12",
      "wrangler": "^4.115.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@orpc/client": "^1.14.12",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev -F web -F server",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:generate": "turbo run db:generate -F @karir-mulai-plus/db",
    "deploy": "cd apps/server && bunx wrangler deploy && cd ../web && bun run build && bunx wrangler deploy",
    "deploy:staging": "cd apps/server && bun run deploy:staging && cd ../web && bun run build:staging && cd apps/web && bunx wrangler deploy",
    "db:migrate:local": "cd apps/server && bun run db:migrate:local",
    "db:migrate:remote": "cd apps/server && bun run db:migrate:remote",
    "db:migrate:staging": "cd apps/server && bun run db:migrate:staging",
    "destroy": "turbo run destroy -F @karir-mulai-plus/infra",
    "dev:full": "turbo run dev"
  },
  "dependencies": {
    "@karir-mulai-plus/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@karir-mulai-plus/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}