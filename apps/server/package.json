{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "wrangler dev --port 3000",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply karir-mulai-plus-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply karir-mulai-plus-db --remote",
    "db:migrate:staging": "wrangler d1 migrations apply karir-mulai-plus-db-staging --remote --env staging",
    "secret:staging": "wrangler secret put BETTER_AUTH_SECRET --env staging"
  },
  "dependencies": {
    "@karir-mulai-plus/api": "workspace:*",
    "@karir-mulai-plus/auth": "workspace:*",
    "@karir-mulai-plus/db": "workspace:*",
    "@karir-mulai-plus/env": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@karir-mulai-plus/config": "workspace:*",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}