{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mulai-plus-web",
  "main": "virtual:tanstack-start-server-entry",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "karir.mulaiplus.id", "custom_domain": true }
  ],
  "env": {
    "staging": {
      "name": "mulai-plus-web-staging",
      "routes": [{ "pattern": "staging.karir.mulaiplus.id", "custom_domain": true }]
    }
  }
}
